{
  "name": "freebike",
  "version": "0.1.0",
  "private": true,
  "description": "Lightweight offline indoor cycling trainer app with low-poly 3D world and BLE sensor support",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "@types/web-bluetooth": "^0.0.22",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
